# Salin file ini menjadi .env lalu isi sesuai PostgreSQL di laptopmu.
# Jangan commit file .env ke GitHub.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=toko_kue
DB_USER=postgres
DB_PASSWORD=isi_password_postgres_kamu
# Isi dengan teks acak panjang. Kalau kosong, sesi login hilang tiap server restart.
SECRET_KEY=
# Mode yang dipakai untuk memeriksa login: plain / hash / salted (default: salted)
LOGIN_MODE=salted
# Nama toko yang tampil di halaman web
SHOP_NAME=Dapur Cantika
